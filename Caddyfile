# Caddy 2 config for series.gamegears.ai.
# Replace the hostname below to match your real domain. Caddy will fetch a
# Let's Encrypt cert automatically on first request.

# Global options — disable HTTP/3 (QUIC). Symptoms on Coolify VPS were
# `net::ERR_QUIC_PROTOCOL_ERROR.QUIC_TOO_MANY_RTOS` for ~30% of MP3/PNG
# requests (network MTU / UDP unreliability). HTTP/2 over TLS is plenty
# fast for this traffic and rock-solid.
{
    servers {
        protocols h1 h2
    }
}

series.gamegears.ai {
    encode gzip zstd

    # Larger uploads for image refs (50 MB).
    request_body {
        max_size 100MB
    }

    # Long-running renders need long proxy timeouts.
    reverse_proxy app:8080 {
        transport http {
            response_header_timeout 600s
            read_timeout 600s
        }
    }

    # Tighten security headers.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
}
